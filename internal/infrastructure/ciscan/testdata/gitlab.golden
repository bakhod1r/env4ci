-           LINT_TOKEN           secret   gitlab stages=lint branches=* sources=.gitlab/ci/lint-go.yml
-           REGISTRY_PASSWORD    secret   gitlab stages=build branches=* sources=.gitlab-ci.yml
-           REGISTRY_USER        secret   gitlab stages=all,build branches=* sources=.gitlab-ci.yml
-           SONAR_HOST           secret   gitlab stages=test branches=* sources=.gitlab-ci.yml
-           SONAR_TOKEN          secret   gitlab stages=test branches=* sources=.gitlab-ci.yml
production  DATABASE_URL         secret   gitlab stages=deploy branches=(default),/^release\/ sources=.gitlab/ci/deploy.yml
production  LOG_LEVEL            variable gitlab stages=deploy branches=(default),/^release\/ sources=.gitlab/ci/deploy.yml
staging     DATABASE_URL         secret   gitlab stages=deploy branches=develop sources=.gitlab/ci/deploy.yml
