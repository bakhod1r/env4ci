# env4ci settings (tokens, addresses). Never committed, never synced.
# Generated by env4ci gen. Fill in values; this file must not be committed.

# github: fine-grained token, Secrets + Variables read/write (empty = gh auth token)
GITHUB_TOKEN=

# vault: address (empty = targets.vault.address)
VAULT_ADDR=
# vault: token with read/create/update on the KV path (empty = ~/.vault-token)
VAULT_TOKEN=
# vault: Enterprise/HCP namespace (optional)
VAULT_NAMESPACE=
